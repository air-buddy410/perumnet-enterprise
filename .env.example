# PostgreSQL is recommended for a persistent VPS deployment.
DATABASE_URL=postgresql://perumnet_enterprise:change-me@127.0.0.1:5432/perumnet_enterprise
DATABASE_POOL_SIZE=10
DATABASE_SSL=disable

# Local development works without database variables and creates
# perumnet.local.db. Turso remains supported for serverless deployments.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Public application URL. Keep NEXT_PUBLIC_BASE_PATH empty so the company site
# is served at /, the CMS at /panel, and the ERP at /admin.
NEXT_PUBLIC_BASE_PATH=
APP_URL=https://enterprise.perumnet.com
APP_ALLOWED_ORIGINS=https://enterprise.perumnet.id

# Public customer-lead protection. Create separate Turnstile widgets for demo
# and production. The secret stays server-side; the site key is public.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=enterprise.perumnet.id,demo-enterprise.perumnet.com
LEAD_FINGERPRINT_SECRET=

# Required only on the first production start while the database is empty.
# Remove it after the administrator has been created.
SEED_ADMIN_PASSWORD=use-a-long-random-password

# Store uploaded project documents on the VPS instead of inside PostgreSQL.
UPLOAD_DIR=/var/lib/perumnet-enterprise/uploads

# Only enable these for a separate public demo process/build. The demo database
# must never point to the production database.
APP_MODE=production
NEXT_PUBLIC_DEMO_MODE=false
DEMO_DATABASE_URL=postgresql://perumnet_enterprise_demo:change-me@127.0.0.1:5432/perumnet_enterprise_demo
DEMO_ACCOUNT_PASSWORD=use-a-different-long-demo-password
# DEMO_TURSO_DATABASE_URL=
# DEMO_TURSO_AUTH_TOKEN=

# Transactional email. Production connects to the dedicated Mailcow host over
# Tailscale; Mailcow owns the Brevo relay. Use a dedicated Mailcow app password.
# Never commit SMTP_PASS or EMAIL_WORKER_SECRET.
EMAIL_MODE=live
SMTP_HOST=100.65.248.6
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TLS_SERVERNAME=mail.perumnet.id
SMTP_USER=enterprise@perumnet.id
SMTP_PASS=
EMAIL_FROM=PerumNet Enterprise <enterprise@perumnet.id>
EMAIL_REPLY_TO=PerumNet Enterprise <enterprise@perumnet.id>
SECURITY_EMAIL_FROM=PerumNet <no-reply@perumnet.id>
SECURITY_EMAIL_REPLY_TO=PerumNet Enterprise <enterprise@perumnet.id>

# AI Catalog Assistant (store the real key only in the server secret file).
# Provider satu-satunya adalah Google Gemini. Free tier: buat key gratis di
# https://aistudio.google.com. GEMINI_BASE_URL opsional untuk endpoint kustom.
GEMINI_API_KEY=
GEMINI_CATALOG_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=
EMAIL_WORKER_SECRET=
EMAIL_WORKER_APP_URL=http://127.0.0.1:3100
EMAIL_WORKER_INTERVAL_MS=30000

# Resend remains an optional compatibility fallback when SMTP is not configured.
RESEND_API_KEY=

# Admin-only Mailcow login branding. Demo must use capture. Production uses a
# dedicated forced-command SSH key that cannot open a shell or run Docker.
MAIL_BRANDING_MODE=ssh
MAIL_BRANDING_SSH_TARGET=mailcow-branding@perumnet-mail
MAIL_BRANDING_SSH_KEY_PATH=/etc/perumnet-enterprise/secrets/mailcow-branding-ed25519
MAIL_BRANDING_KNOWN_HOSTS_PATH=/etc/perumnet-enterprise/secrets/mailcow-known-hosts

# Optional read-only bank connector. The endpoint must accept the documented
# POST contract from README.md and keep all bank credentials on the server.
# Manual BCA PDF and BCA/generic CSV import remains available without these variables.
BANK_SYNC_API_URL=
BANK_SYNC_API_TOKEN=
